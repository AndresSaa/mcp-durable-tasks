{
  "name": "mcp-durable-tasks",
  "version": "0.2.1",
  "description": "Server-side implementation of the MCP Tasks extension (SEP-2663). Not a to-do manager.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./wal": {
      "import": {
        "types": "./dist/wal.d.ts",
        "default": "./dist/wal.js"
      },
      "require": {
        "types": "./dist/wal.d.cts",
        "default": "./dist/wal.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs/api.md",
    "docs/contract.md",
    "docs/durability.md",
    "docs/internals.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/wal.ts src/testing.ts --format cjs,esm --dts --clean",
    "prepack": "node --run build",
    "test": "node --run build && vitest run",
    "test:watch": "node --run build && vitest",
    "coverage": "node --run build && vitest run --coverage",
    "lint": "tsc --noEmit && eslint . && prettier . --check",
    "lint:package": "publint --strict && attw --pack . --profile node16 && node --run smoke:package",
    "smoke:package": "node scripts/smoke-packed.mjs",
    "check:schema": "node scripts/check-schema.mjs"
  },
  "peerDependencies": {
    "process-wal": "^1.5.1"
  },
  "peerDependenciesMeta": {
    "process-wal": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndresSaa/mcp-durable-tasks.git"
  },
  "bugs": {
    "url": "https://github.com/AndresSaa/mcp-durable-tasks/issues"
  },
  "homepage": "https://github.com/AndresSaa/mcp-durable-tasks#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-extension",
    "sep-2663",
    "io.modelcontextprotocol/tasks",
    "tasks",
    "durable",
    "crash-recovery",
    "task-store",
    "typescript",
    "zero-dependency"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "prettier": "3.9.6",
    "process-wal": "^1.5.1",
    "publint": "^0.3.22",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10"
  }
}
