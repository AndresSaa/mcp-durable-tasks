{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  // The vendored ext-tasks schema is data, not source: the tests read it as
  // text. It also imports from `@modelcontextprotocol/sdk`, which this package
  // does not depend on, so typechecking it would fail on an import that is
  // upstream's business rather than ours.
  "exclude": ["test/fixtures/**"]
}
